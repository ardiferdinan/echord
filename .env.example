# Neon connection string (Vercel > Storage > Neon akan mengisi ini otomatis)
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Login pertama: belum ada akun, masuk dengan username pilihanmu + password ini untuk membuat akun super admin.
# Setelah itu login memakai akun (username/email + password); ADMIN_PASSWORD tidak dipakai lagi untuk masuk.
ADMIN_PASSWORD=ganti-ini
# (opsional) kunci tanda tangan sesi; kalau kosong dipakai ADMIN_PASSWORD. Mengganti nilainya mengeluarkan semua sesi.
SESSION_SECRET=
